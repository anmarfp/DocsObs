# ==============================================================================
# DocsObs — Variáveis de produção (docker-compose.yml + docker-compose.prod.yml)
# ==============================================================================
# No servidor: cp .env.production.example .env e preencha. Nunca versione o .env.
# Plano completo: docs/deploy/oracle-cloud.md (DOC-46).
# NODE_ENV=production já é fixado pelo compose.

# Domínio público (ex.: docsobs.duckdns.org). O Caddy emite o certificado para ele
# e o backend usa https://<DOMAIN> como FRONTEND_URL.
DOMAIN=""

# Fuso horário de negócio (IANA) para o cálculo de status e o cron diário.
APP_TIMEZONE="America/Sao_Paulo"

# Banco de dados. Use senha forte e apenas letras e números: ela entra sem escape
# na DATABASE_URL. Gere com: openssl rand -hex 24
POSTGRES_USER="docsobs"
POSTGRES_PASSWORD=""
POSTGRES_DB="docsobs"

# Autenticação JWT — obrigatório, mínimo 32 caracteres (DOC-33). Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Seed: true só na PRIMEIRA subida, depois volte para false (DOC-32).
# Com RUN_SEED=true as duas senhas abaixo são obrigatórias (mín. 12 caracteres);
# troque-as pela aplicação após o primeiro login.
RUN_SEED=false
ADMIN_SEED_PASSWORD=""
OPERATIONAL_SEED_PASSWORD=""

# E-mail (SMTP) para os alertas de vencimento (DOC-31). Vazio = envio desativado.
# Com SMTP_HOST preenchido, EMAIL_FROM é obrigatório; SMTP_USER e SMTP_PASS vão juntos.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM=""

# Recálculo diário de status e digest às 00:00 em APP_TIMEZONE.
CRON_ENABLED=true

# Google Agenda (OAuth por usuário — ADR-009). Preencha as três juntas ou nenhuma:
# configuração parcial impede o backend de subir.
# GOOGLE_REDIRECT_URI deve ser exatamente https://<DOMAIN>/api/v1/calendar/google/callback
# e estar cadastrada no cliente OAuth do Google Cloud.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
# Chave AES-256-GCM dos tokens OAuth em repouso (DOC-44). Obrigatória com o Google
# configurado; mantenha-a estável entre deploys (trocar desconecta as agendas). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Serviço de OCR (opcional): só com o perfil ativo
# (docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile extraction up -d --build).
EXTRACTION_SERVICE_URL=""
EXTRACTION_TIMEOUT_MS=60000
