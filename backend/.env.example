# Ambiente da Aplicação
NODE_ENV=development
PORT=3001

# Fuso horário de negócio (IANA) usado para definir "hoje" no cálculo de status
# e nos próximos vencimentos do dashboard (DOC-27). Vencimentos são datas civis
# gravadas como meia-noite UTC; padrão: America/Sao_Paulo.
APP_TIMEZONE="America/Sao_Paulo"

# Banco de Dados Local (PostgreSQL via Docker)
# Substitua os valores abaixo pelos seus próprios antes de subir o ambiente —
# não reutilize os exemplos em nenhum ambiente acessível fora da sua máquina.
DATABASE_URL="postgresql://changeme_user:changeme_password@localhost:5432/changeme_db?schema=public"

# Autenticação JWT — obrigatório em produção, mínimo 32 caracteres.
# Gere um valor seguro com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="changeme_use_a_long_random_secret_value"
JWT_EXPIRES_IN="7d"

# Senhas dos usuários criados pelo seed. Não há senhas padrão.
# - NODE_ENV=production: ADMIN_SEED_PASSWORD e OPERATIONAL_SEED_PASSWORD são
#   obrigatórias (mín. 12 caracteres); sem elas o seed falha. Usuários e
#   documentos de demonstração não são criados em produção.
# - Fora de produção: senha vazia => o seed gera uma senha aleatória por usuário
#   e a exibe uma única vez no console. DEMO_SEED_PASSWORD vale para os demo.
ADMIN_SEED_PASSWORD=""
OPERATIONAL_SEED_PASSWORD=""
DEMO_SEED_PASSWORD=""

# Armazenamento de Arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760

# Agendamento In-Process (CRON)
# Padrão: true (executa recálculo diário e digest a 00:00 no fuso APP_TIMEZONE).
# Defina false para desativar o agendamento em lote neste processo.
CRON_ENABLED=true

# Configurações de E-mail (SMTP)
# Deixe SMTP_HOST vazio para desativar o envio de e-mails (env.smtp = null).
# Quando SMTP_HOST for preenchido, EMAIL_FROM é obrigatório.
# SMTP_USER e SMTP_PASS são all-or-none (ambos preenchidos ou ambos vazios).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false
EMAIL_FROM=""

# Integração com Google Agenda (OAuth por usuário — DOC-28)
# Credenciais do projeto OAuth criado no Google Cloud Console.
GOOGLE_CLIENT_ID="changeme_google_client_id"
GOOGLE_CLIENT_SECRET="changeme_google_client_secret"
GOOGLE_REDIRECT_URI="changeme_google_redirect_uri"

# URL do frontend para onde o callback OAuth do Google Agenda redireciona o
# navegador do usuário após conectar/desconectar (padrão: servidor de dev do Vite).
FRONTEND_URL="http://localhost:5173"
