# Ambiente da Aplicação
NODE_ENV=development
PORT=3001

# Fuso horário de negócio (IANA) usado para definir "hoje" no cálculo de status
# e nos próximos vencimentos do dashboard (DOC-27). Vencimentos são datas civis
# gravadas como meia-noite UTC; padrão: America/Sao_Paulo.
APP_TIMEZONE="America/Sao_Paulo"

# Banco de Dados Local (PostgreSQL via Docker)
# Substitua os valores abaixo pelos seus próprios antes de subir o ambiente —
# não reutilize os exemplos em nenhum ambiente acessível fora da sua máquina.
DATABASE_URL="postgresql://changeme_user:changeme_password@localhost:5432/changeme_db?schema=public"

# Autenticação JWT — gere um valor aleatório longo, nunca reutilize o exemplo
JWT_SECRET="changeme_use_a_long_random_secret_value"
JWT_EXPIRES_IN="7d"

# Senhas dos usuários criados pelo seed (opcional).
# Se não definidas, o seed usa as senhas padrão documentadas no PRD (ambiente
# de demonstração local apenas) — defina estas variáveis em qualquer ambiente
# que não seja um demo local descartável.
ADMIN_SEED_PASSWORD=""
OPERATIONAL_SEED_PASSWORD=""
DEMO_SEED_PASSWORD=""

# Armazenamento de Arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760

# Configurações de E-mail (Opcional no dev)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DocsObs <alertas@docsobs.com.br>"

# Integração com Google Agenda (OAuth por usuário — DOC-28)
# Credenciais do projeto OAuth criado no Google Cloud Console.
GOOGLE_CLIENT_ID="changeme_google_client_id"
GOOGLE_CLIENT_SECRET="changeme_google_client_secret"
GOOGLE_REDIRECT_URI="changeme_google_redirect_uri"

# URL do frontend para onde o callback OAuth do Google Agenda redireciona o
# navegador do usuário após conectar/desconectar (padrão: servidor de dev do Vite).
FRONTEND_URL="http://localhost:5173"
