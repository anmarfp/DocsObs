generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONAL
}

enum NotificationMode {
  ALL_ADMINS
  ONLY_RESPONSIBLE
}

enum DocumentStatus {
  EXPIRED
  CRITICAL
  RENEWAL_IN_PROGRESS
  REGULAR
  INDETERMINATE
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  UNARCHIVE
  DELETE
  RENEW
}

enum SyncStatus {
  SYNCED
  ERROR
  DELETED
}

model CompanyConfig {
  id               String           @id @default(uuid())
  notificationMode NotificationMode @default(ALL_ADMINS) @map("notification_mode")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  updatedById      String?          @map("updated_by_id")
  updatedBy        User?            @relation("CompanyConfigUpdater", fields: [updatedById], references: [id])

  @@index([updatedById])
  @@map("company_config")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(OPERATIONAL)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdDocuments Document[]        @relation("DocumentCreator")
  renewedVersions  DocumentVersion[] @relation("VersionRenewer")
  auditLogs        AuditLog[]        @relation("UserAuditor")
  updatedConfigs   CompanyConfig[]   @relation("CompanyConfigUpdater")
  googleOAuthToken GoogleOAuthToken?

  @@map("users")
}

model DocumentCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  colorHex    String?  @map("color_hex")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  documents Document[]

  @@map("document_categories")
}

model Document {
  id                 String         @id @default(uuid())
  title              String
  categoryId         String         @map("category_id")
  category           DocumentCategory @relation(fields: [categoryId], references: [id])
  issuingBody        String?        @map("issuing_body")
  issueDate          DateTime       @map("issue_date")
  expirationDate     DateTime?      @map("expiration_date")
  alertLeadDays      Int            @default(30) @map("alert_lead_days")
  status             DocumentStatus @default(REGULAR)
  responsibleName    String?        @map("responsible_name")
  responsibleEmail   String?        @map("responsible_email")
  attachmentUrl      String?        @map("attachment_url")
  attachmentFilename String?        @map("attachment_filename")
  fileSizeBytes      Int?           @map("file_size_bytes")
  fileMimeType       String?        @map("file_mime_type")
  notes              String?
  isArchived         Boolean        @default(false) @map("is_archived")
  createdById        String         @map("created_by_id")
  createdBy          User           @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  versions     DocumentVersion[]
  auditLogs    AuditLog[]
  gcalSyncLogs GCalSyncLog[]

  @@index([categoryId])
  @@index([createdById])
  // Contagens do dashboard por status e cron (isArchived = false AND status IN ...).
  @@index([isArchived, status])
  // Faixas de vencimento (dashboard 30 dias, calendario) com ORDER BY expirationDate.
  @@index([expirationDate])
  // Listagem padrao ORDER BY createdAt DESC.
  @@index([createdAt])
  // Busca da listagem: OR de ILIKE '%termo%' em title/issuingBody/responsibleName/notes.
  // Um unico GIN trigram multicoluna permite BitmapOr sobre os quatro ramos; um
  // indice so em title nao e usado, pois os outros ramos do OR forcam seq scan.
  // Requer a extensao pg_trgm, criada em SQL bruto na migration
  // 20261014144718_add_indexes (o schema nao usa a preview postgresqlExtensions).
  @@index([title(ops: raw("gin_trgm_ops")), issuingBody(ops: raw("gin_trgm_ops")), responsibleName(ops: raw("gin_trgm_ops")), notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "documents_search_trgm_idx")
  @@map("documents")
}

model DocumentVersion {
  id                 String    @id @default(uuid())
  documentId         String    @map("document_id")
  document           Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber      Int       @map("version_number")
  issueDate          DateTime  @map("issue_date")
  expirationDate     DateTime? @map("expiration_date")
  attachmentUrl      String?   @map("attachment_url")
  attachmentFilename String?   @map("attachment_filename")
  notes              String?
  renewedById        String    @map("renewed_by_id")
  renewedBy          User      @relation("VersionRenewer", fields: [renewedById], references: [id])
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([documentId])
  @@index([renewedById])
  @@map("document_versions")
}

model AuditLog {
  id         String      @id @default(uuid())
  documentId String?     @map("document_id")
  document   Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId     String?     @map("user_id")
  user       User?       @relation("UserAuditor", fields: [userId], references: [id], onDelete: SetNull)
  userName   String      @map("user_name")
  action     AuditAction
  diffData   Json        @map("diff_data")
  timestamp  DateTime    @default(now())

  // Pagina de auditoria: ORDER BY timestamp DESC LIMIT n.
  @@index([timestamp])
  // Historico por documento (WHERE documentId ORDER BY timestamp DESC); cobre a FK.
  @@index([documentId, timestamp])
  @@index([userId])
  @@map("audit_logs")
}

model GCalSyncLog {
  id           String     @id @default(uuid())
  documentId   String     @map("document_id")
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  gcalEventId  String?    @map("gcal_event_id")
  status       SyncStatus @default(SYNCED)
  lastSyncedAt DateTime   @default(now()) @map("last_synced_at")
  errorMessage String?    @map("error_message")

  // findCurrentGcalEventId: WHERE documentId ORDER BY lastSyncedAt DESC LIMIT 1; cobre a FK.
  @@index([documentId, lastSyncedAt])
  @@map("gcal_sync_logs")
}

model GoogleOAuthToken {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiryDate   DateTime @map("expiry_date")
  scope        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("google_oauth_tokens")
}
